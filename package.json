{
  "name": "funcons",
  "version": "1.0.0",
  "description": "Deterministic, procedurally generated icons as SVG. No network, no assets, no runtime dependencies.",
  "license": "Apache-2.0",
  "author": "AltaCoda",
  "repository": { "type": "git", "url": "git+https://github.com/AltaCoda/funcons.git" },
  "homepage": "https://github.com/AltaCoda/funcons#readme",
  "bugs": { "url": "https://github.com/AltaCoda/funcons/issues" },
  "keywords": ["icon", "identicon", "avatar", "svg", "procedural", "generative", "deterministic", "react"],
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite",
    "readme:images": "pnpm build && node scripts/readme-images.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
